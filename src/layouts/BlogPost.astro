---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Stamp from '../components/Stamp.astro';
import { readingTimeLabel, UPDATED_ON_LABEL } from '../consts';
import Layout from './Layout.astro';

type Props = Omit<CollectionEntry<'blog'>['data'], 'category'> &
	Partial<Pick<CollectionEntry<'blog'>['data'], 'category'>> & { readingMinutes: number };

const { title, description, pubDate, updatedDate, category, heroImage, heroAlt, readingMinutes } = Astro.props;
---

<Layout title={title} description={description} image={heroImage}>
	<style>
		:global(main) {
			width: 100%;
			max-width: 100%;
			margin: 0;
		}
		/* Bichromie riso, comme à l'accueil : l'image passe en niveaux de gris, puis multiplie l'aplat rouge. */
		.hero-image {
			width: min(100% - 2rem, 64rem);
			margin: 0 auto;
			isolation: isolate;
			background: var(--ink-red);
			border: 2px solid var(--ink);
		}
		.hero-image img {
			width: 100%;
			aspect-ratio: 2 / 1;
			object-fit: cover;
			filter: grayscale(1) contrast(1.15);
			mix-blend-mode: multiply;
		}
		.prose {
			width: min(100% - 2rem, var(--measure));
			margin: auto;
			padding: 1rem;
		}
		.title {
			margin-bottom: 1rem;
			padding: 1rem 0;
		}
		.title h1 {
			margin: 0 0 0.5em;
		}
		.date {
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem 1.25rem;
			margin: 0 0 0.5rem;
			color: var(--ink-soft);
			font-family: var(--font-mono);
			font-size: 0.9rem;
		}
		.updated-on {
			font-style: italic;
		}
		/* Lettrine : float partout, initial-letter là où le navigateur le sait (Firefox reste en float). */
		.content > :global(p:first-of-type)::first-letter {
			float: left;
			padding-right: 0.08em;
			color: var(--ink-red);
			font-family: var(--font-text);
			font-size: 4.2em;
			font-weight: 900;
			line-height: 0.8;
		}
		@supports (initial-letter: 3) {
			.content > :global(p:first-of-type)::first-letter {
				float: none;
				padding-right: 0.1em;
				font-size: inherit;
				line-height: inherit;
				initial-letter: 3;
			}
		}
	</style>
	<article>
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt={heroAlt ?? ''} />
				</div>
			)
		}
		<div class="prose">
			<header class="title">
				{category && <Stamp category={category} />}
				<h1>{title}</h1>
				<p class="date">
					<FormattedDate date={pubDate} />
					<span>{readingTimeLabel(readingMinutes)}</span>
					{
						updatedDate && (
							<span class="updated-on">
								{UPDATED_ON_LABEL} <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</p>
				<hr />
			</header>
			<div class="content">
				<slot />
			</div>
		</div>
	</article>
</Layout>
