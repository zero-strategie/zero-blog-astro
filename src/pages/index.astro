---
import ArticleRow from '../components/ArticleRow.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import Layout from '../layouts/Layout.astro';
import {
	EMPTY_HOME_MESSAGE,
	MANIFESTO,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SUMMARY_LABEL,
	rubriqueOf,
} from '../consts';
import { splitFeatured } from '../lib/featured.mjs';
import { getArticles } from '../lib/strapi/article';
import { articleUrl } from '../lib/url';

const { featured, summary } = splitFeatured(await getArticles());
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="manifesto">
		<p class="kicker">{MANIFESTO.kicker}</p>
		<h1>{MANIFESTO.title}</h1>
		{MANIFESTO.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
	</section>
	{
		featured ? (
			<>
				<FeaturedArticle
					title={featured.title}
					description={featured.description}
					href={articleUrl(featured.slug)}
					pubDate={featured.publishedAt}
					category={rubriqueOf(featured.category)}
					contentType={featured.contentType}
					cover={featured.cover}
				/>
				{summary.length > 0 && (
					<section class="summary" aria-labelledby="sommaire">
						<h2 id="sommaire" class="summary-title">{SUMMARY_LABEL}</h2>
						<ul>
							{summary.map((post) => (
								<ArticleRow
									title={post.title}
									href={articleUrl(post.slug)}
									pubDate={post.publishedAt}
									category={rubriqueOf(post.category)}
									contentType={post.contentType}
									headingLevel={3}
								/>
							))}
						</ul>
					</section>
				)}
			</>
		) : (
			<p class="empty">{EMPTY_HOME_MESSAGE}</p>
		)
	}
</Layout>

<style>
	.manifesto {
		margin: 0 0 3rem;
		padding: 0 0 2rem;
		border-bottom: 0.5rem solid var(--ink-red);
	}
	.kicker {
		margin: 0 0 0.5rem;
		color: var(--ink-red-text);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.manifesto h1 {
		margin-bottom: 1.25rem;
	}
	.manifesto p:not(.kicker) {
		max-width: var(--measure);
	}
	.summary-title {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.summary ul {
		margin: 0;
		padding: 0;
		list-style: none;
		border-bottom: 1px solid var(--ink);
	}
	.empty {
		font-style: italic;
	}
</style>
