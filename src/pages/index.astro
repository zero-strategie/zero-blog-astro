---
import ArticleList from '../components/ArticleList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';
import { getArticles } from '../lib/strapi/article';
import { getCategories } from '../lib/strapi/category';
import { BLOG_HREF, categoryHref } from '../lib/url';

const LATEST = 6;
const [articles, categories] = await Promise.all([getArticles(), getCategories()]);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<h1>{SITE_TITLE}</h1>
	<p class="intro">{SITE_DESCRIPTION}</p>

	{categories.length > 0 && (
		<nav aria-label="Catégories">
			<ul class="categories">
				{categories.map((category) => (
					<li>
						<a href={categoryHref(category.slug)}>{category.name}</a>
					</li>
				))}
			</ul>
		</nav>
	)}

	<h2>Derniers articles</h2>
	<ArticleList
		articles={articles.slice(0, LATEST)}
		emptyMessage="Aucun article publié pour l'instant."
	/>
	{articles.length > LATEST && (
		<p>
			<a href={BLOG_HREF}>Voir tous les articles</a>
		</p>
	)}
</Layout>

<style>
	.intro {
		font-size: 1.1em;
	}
	.categories {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em 1em;
		margin: 0 0 2em;
		padding: 0;
		list-style: none;
	}
	h2 {
		font-size: 1.6em;
	}
</style>
