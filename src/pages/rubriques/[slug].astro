---
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
import {
	ARCHIVE_LINK_LABEL,
	CATEGORIES,
	categoryDescription,
	categoryHeading,
	EMPTY_CATEGORY_MESSAGE,
	SITE_TITLE,
} from '../../consts';
import { getArticlesByCategory } from '../../lib/strapi/article';
import { archiveUrl, articleUrl } from '../../lib/url';

// Une page par rubrique, même vide. Strapi filtre par catégorie et trie du plus récent au plus ancien.
export async function getStaticPaths() {
	return Promise.all(
		CATEGORIES.map(async (category) => ({
			params: { slug: category.slug },
			props: { category, posts: await getArticlesByCategory(category.slug) },
		})),
	);
}

const { category, posts } = Astro.props;
const heading = categoryHeading(category.slug);
---

<Layout title={`${heading} — ${SITE_TITLE}`} description={categoryDescription(category.label)}>
	<h1>{heading}</h1>
	{posts.length === 0 ? (
		<p>
			{EMPTY_CATEGORY_MESSAGE}. <a href={archiveUrl()}>{ARCHIVE_LINK_LABEL}</a>
		</p>
	) : (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={articleUrl(post.slug)}>{post.title}</a>
					<FormattedDate date={post.publishedAt} />
				</li>
			))}
		</ul>
	)}
</Layout>

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--ink-soft);
	}
	li :global(time) {
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}
</style>
