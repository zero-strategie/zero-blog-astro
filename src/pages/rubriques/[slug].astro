---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Layout.astro';
import {
	ARCHIVE_LINK_LABEL,
	CATEGORIES,
	categoryDescription,
	categoryHeading,
	EMPTY_CATEGORY_MESSAGE,
	SITE_TITLE,
} from '../../consts';
import { archiveUrl, articleUrl } from '../../lib/url';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return CATEGORIES.map((category) => ({
		params: { slug: category.slug },
		props: {
			category,
			posts: posts
				.filter((post) => post.data.category === category.slug)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { category, posts } = Astro.props;
const heading = categoryHeading(category.slug);
---

<Layout title={`${heading} — ${SITE_TITLE}`} description={categoryDescription(category.label)}>
	<h1>{heading}</h1>
	{
		posts.length === 0 ? (
			<p>
				{EMPTY_CATEGORY_MESSAGE}. <a href={archiveUrl()}>{ARCHIVE_LINK_LABEL}</a>
			</p>
		) : (
			<ul>
				{posts.map((post) => (
					<li>
						<a href={articleUrl(post.id)}>{post.data.title}</a>
						<FormattedDate date={post.data.pubDate} />
					</li>
				))}
			</ul>
		)
	}
</Layout>

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--ink-soft);
	}
	li :global(time) {
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}
</style>
