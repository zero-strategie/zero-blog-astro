---
import { getCollection } from 'astro:content';
import ArticleRow from '../../components/ArticleRow.astro';
import Layout from '../../layouts/Layout.astro';
import {
	ARCHIVE_DESCRIPTION,
	ARCHIVE_TITLE,
	EMPTY_ARCHIVE_MESSAGE,
	SITE_TITLE,
} from '../../consts';
import { articleUrl } from '../../lib/url';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={`${ARCHIVE_TITLE} — ${SITE_TITLE}`} description={ARCHIVE_DESCRIPTION}>
	<h1>{ARCHIVE_TITLE}</h1>
	{
		posts.length === 0 ? (
			<p class="empty">{EMPTY_ARCHIVE_MESSAGE}</p>
		) : (
			<ul>
				{posts.map((post) => (
					<ArticleRow
						title={post.data.title}
						href={articleUrl(post.id)}
						pubDate={post.data.pubDate}
						category={post.data.category}
					/>
				))}
			</ul>
		)
	}
</Layout>

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
		border-bottom: 1px solid var(--ink);
	}
	.empty {
		font-style: italic;
	}
</style>
