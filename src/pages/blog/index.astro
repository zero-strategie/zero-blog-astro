---
import ArticleList from '../../components/ArticleList.astro';
import { SITE_TITLE } from '../../consts';
import Layout from '../../layouts/Layout.astro';
import { getArticles } from '../../lib/strapi/article';

const articles = await getArticles();
---

<Layout
	title="Tous les articles"
	description={`Tous les articles de ${SITE_TITLE}, du plus récent au plus ancien : actualités, analyses, enquêtes, décryptages et opinions, chacun avec ses sources.`}
>
	<h1>Tous les articles</h1>
	<ArticleList articles={articles} emptyMessage="Aucun article publié pour l'instant." />
</Layout>
