---
import Layout from '../layouts/Layout.astro';
import { ABOUT, SITE_TITLE } from '../consts';
---

<Layout title={`${ABOUT.title} — ${SITE_TITLE}`} description={ABOUT.description}>
	<h1>{ABOUT.title}</h1>
	{ABOUT.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
</Layout>

<style>
	p {
		max-width: var(--measure);
	}
</style>
