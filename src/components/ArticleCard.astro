---
import type { ContentType, ImageRef } from '../types/domain';
import ContentTypeBadge from './ContentTypeBadge.astro';
import FormattedDate from './FormattedDate.astro';

// Narrow on purpose: a card never needs blocks or sources (AGENTS.md 4.4).
interface Props {
	href: string;
	title: string;
	description?: string;
	contentType: ContentType;
	publishedAt: Date;
	categoryName?: string;
	cover?: ImageRef;
}

const { href, title, description, contentType, publishedAt, categoryName, cover } = Astro.props;
---

<article class="card">
	{cover && (
		<img
			src={cover.url}
			alt={cover.alt}
			width={cover.width}
			height={cover.height}
			loading="lazy"
			decoding="async"
		/>
	)}
	<p class="kicker">
		<ContentTypeBadge type={contentType} />
		{categoryName && <span class="category">{categoryName}</span>}
	</p>
	<h2 class="title">
		<a href={href}>{title}</a>
	</h2>
	{description && <p class="description">{description}</p>}
	<p class="date">
		<FormattedDate date={publishedAt} />
	</p>
</article>

<style>
	.card {
		position: relative;
	}
	img {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		margin-bottom: 0.5rem;
	}
	.kicker {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin: 0 0 0.25em;
	}
	.category {
		color: rgb(var(--gray));
		font-size: 0.8em;
	}
	.title {
		margin: 0 0 0.25em;
		font-size: 1.4em;
	}
	.title a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	/* The whole card is clickable through the title link. */
	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.card:hover .title a {
		color: var(--accent);
	}
	.description {
		margin: 0 0 0.25em;
		font-size: 0.9em;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
</style>
