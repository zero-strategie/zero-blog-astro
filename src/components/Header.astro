---
import { SITE_TITLE } from '../consts';
import { ABOUT_HREF, BLOG_HREF, HOME_HREF } from '../lib/url';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Navigation principale">
		<p class="site-title"><a href={HOME_HREF}>{SITE_TITLE}</a></p>
		<div class="internal-links">
			<HeaderLink href={HOME_HREF}>Accueil</HeaderLink>
			<HeaderLink href={BLOG_HREF}>Articles</HeaderLink>
			<HeaderLink href={ABOUT_HREF}>À propos</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.site-title {
		margin: 0;
		font-size: 1em;
		font-weight: 700;
	}
	.site-title a {
		text-decoration: none;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a:global(.active) {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
