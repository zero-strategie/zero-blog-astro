---
import { NAV_LINKS, SITE_TAGLINE, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<p class="masthead"><a href="/">{SITE_TITLE}</a></p>
	<p class="tagline">{SITE_TAGLINE}</p>
	<nav aria-label="Navigation principale">
		{NAV_LINKS.map(({ href, label }) => <HeaderLink href={href}>{label}</HeaderLink>)}
	</nav>
</header>
