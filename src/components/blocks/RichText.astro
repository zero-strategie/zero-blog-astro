---
import type { RichTextBlock } from '../../types/domain';

type Props = RichTextBlock;

// Already sanitised by renderMarkdown() in the mapper — the SafeHtml brand
// guarantees it. No wrapper: paragraphs stay direct children of the article
// column, which the drop cap and the margin notes rely on.
const { html } = Astro.props;
---

<Fragment set:html={html} />
