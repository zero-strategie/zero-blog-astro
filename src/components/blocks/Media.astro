---
import type { MediaBlock } from '../../types/domain';
import CmsImage from '../CmsImage.astro';

type Props = MediaBlock;

const { image, caption } = Astro.props;
const WIDTHS = [480, 800, 1200];
const SIZES = '(min-width: 48rem) 41em, 100vw';
---

{
	image && (
		<figure class="media">
			<CmsImage image={image} widths={WIDTHS} sizes={SIZES} loading="lazy" />
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	)
}

<style>
	.media {
		margin: 2rem 0;
	}
	figcaption {
		margin-top: 0.4rem;
		color: var(--ink-soft);
		font-size: 0.85rem;
	}
</style>
