---
import type { MediaBlock } from '../../types/domain';

type Props = MediaBlock;

const { image, caption } = Astro.props;
---

{image && (
	<figure class="media">
		<img
			src={image.url}
			alt={image.alt}
			width={image.width}
			height={image.height}
			loading="lazy"
			decoding="async"
		/>
		{caption && <figcaption>{caption}</figcaption>}
	</figure>
)}

<style>
	.media {
		margin: 2em 0;
	}
	figcaption {
		margin-top: 0.25em;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
</style>
