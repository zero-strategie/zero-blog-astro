---
import { articleHref } from '../lib/url';
import type { ArticleSummary } from '../types/domain';
import ArticleCard from './ArticleCard.astro';

interface Props {
	articles: readonly ArticleSummary[];
	/** Said out loud when the list is empty — never a silently blank page. */
	emptyMessage: string;
}

const { articles, emptyMessage } = Astro.props;
---

{
	articles.length > 0 ? (
		<ul class="articles">
			{articles.map((article) => (
				<li>
					<ArticleCard
						href={articleHref(article.slug)}
						title={article.title}
						description={article.description}
						contentType={article.contentType}
						publishedAt={article.publishedAt}
						categoryName={article.category?.name}
						cover={article.cover}
					/>
				</li>
			))}
		</ul>
	) : (
		<p class="empty" role="status">
			{emptyMessage}
		</p>
	)
}

<style>
	.articles {
		display: grid;
		gap: 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.empty {
		padding: 1em;
		border: 1px dashed rgb(var(--gray));
		border-radius: 4px;
		color: rgb(var(--gray-dark));
	}
</style>
