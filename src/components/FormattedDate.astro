---
interface Props {
	date: Date;
}

const { date } = Astro.props;
// UTC : la date éditoriale ne doit pas reculer d'un jour selon le fuseau du build.
const formatter = new Intl.DateTimeFormat('fr-FR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<time datetime={date.toISOString()}>{formatter.format(date)}</time>
