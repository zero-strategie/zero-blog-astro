---
import { SITE_TITLE } from '../consts';
import { ABOUT_HREF, RSS_HREF } from '../lib/url';

const year = new Date().getFullYear();
---

<footer>
	<p>&copy; {year} {SITE_TITLE}. Chaque affirmation factuelle est sourcée.</p>
	<p>
		<a href={ABOUT_HREF}>Notre méthode</a> · <a href={RSS_HREF}>Flux RSS</a>
	</p>
</footer>

<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
	}
	footer p {
		margin: 0.25em 0;
	}
	a {
		color: rgb(var(--gray-dark));
	}
</style>
