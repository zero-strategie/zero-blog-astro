---
import type { FaqItem } from '../types/domain';

interface Props {
	items: readonly FaqItem[];
}

const { items } = Astro.props;
---

{
	items.length > 0 && (
		<section class="faq" aria-labelledby="faq-titre">
			<h2 id="faq-titre">Questions fréquentes</h2>
			{items.map((item) => (
				<div class="faq-item">
					<h3>{item.question}</h3>
					<div set:html={item.answer} />
				</div>
			))}
		</section>
	)
}

<style>
	.faq {
		margin-top: 3em;
	}
	.faq h2 {
		font-size: 1.6em;
	}
	h3 {
		font-size: 1.15em;
	}
	.faq-item {
		margin-bottom: 1.5em;
	}
</style>
