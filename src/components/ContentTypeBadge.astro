---
import { CONTENT_TYPE_LABELS } from '../consts';
import type { ContentType } from '../types/domain';

interface Props {
	type: ContentType;
}

const { type } = Astro.props;
---

<span class:list={['badge', 'mono-label', { 'badge--opinion': type === 'opinion' }]}>
	{CONTENT_TYPE_LABELS[type]}
</span>

<style>
	.badge {
		display: inline-block;
		padding: 0.1em 0.5em;
		border: 1px solid var(--ink);
		line-height: 1.5;
		white-space: nowrap;
	}
	/* Une opinion ne doit jamais passer pour un compte rendu : aplat plein, papier sur rouge texte. */
	.badge--opinion {
		border-color: var(--ink-red-text);
		background: var(--ink-red-text);
		color: var(--paper);
	}
</style>
