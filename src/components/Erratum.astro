---
import { ARTICLE_LABELS } from '../consts';
import type { SafeHtml } from '../types/domain';

interface Props {
	html: SafeHtml;
}

const { html } = Astro.props;
---

<aside class="erratum" role="note" aria-labelledby="erratum-titre">
	<p id="erratum-titre" class="erratum-titre mono-label">{ARTICLE_LABELS.erratum}</p>
	<div class="erratum-corps" set:html={html} />
</aside>

<style>
	/* Rectificatif façon papillon collé sur l'épreuve : filet double, titre au tampon. */
	.erratum {
		margin: 0 0 2rem;
		padding: 0.75rem 1rem;
		border: 4px double var(--ink-red-text);
		font-size: 0.95rem;
	}
	.erratum-titre {
		margin: 0 0 0.25rem;
		color: var(--ink-red-text);
	}
	.erratum-corps :global(p) {
		margin: 0;
	}
</style>
