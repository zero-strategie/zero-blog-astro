---
import FormattedDate from './FormattedDate.astro';
import Stamp from './Stamp.astro';
import type { CATEGORIES } from '../consts';

interface Props {
	title: string;
	href: string;
	pubDate: Date;
	category: (typeof CATEGORIES)[number]['slug'];
}

const { title, href, pubDate, category } = Astro.props;
---

<li class="article-row">
	<span class="date"><FormattedDate date={pubDate} /></span>
	<Stamp category={category} />
	<h2><a href={href}>{title}</a></h2>
</li>

<style>
	.article-row {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 0.25rem 1rem;
		padding: 0.9rem 0;
		border-top: 1px solid var(--ink);
	}
	.date {
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	h2 {
		grid-column: 1 / -1;
		margin: 0;
		font-size: 1.4rem;
		font-weight: 700;
	}
	h2 a {
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--ink-red-text);
		text-decoration: underline;
	}
	@media (min-width: 48rem) {
		.article-row {
			grid-template-columns: 11rem auto 1fr;
			gap: 0 1.25rem;
		}
		h2 {
			grid-column: auto;
		}
	}
</style>
