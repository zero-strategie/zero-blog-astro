# Copy to .env and fill in. Never commit .env.
#
# These are declared through the astro:env schema in astro.config.mjs, which
# validates them at build time and enforces the client/server boundary.

# --- Server ----------------------------------------------------------------
# Read by @astrojs/node in standalone mode. The defaults match `astro dev`.
HOST=0.0.0.0
PORT=4321

# --- CMS -------------------------------------------------------------------
# Base origin of the Strapi API. No trailing slash.
#   local:      http://localhost:1337
#   production: https://admin.zero-strategie.dev
STRAPI_URL=http://localhost:1337

# Read-only Strapi API token (Settings > API Tokens). Server-side secret:
# never prefix it with PUBLIC_, never pass it into a client island.
STRAPI_API_TOKEN=
